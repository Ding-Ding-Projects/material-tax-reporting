  "installerStaging": {
    "command": "npm run stage:offline-ocr-assets --workspace @material-tax-reporting/slip-parser -- --output <directory>",
    "layout": "<directory>/node_modules/<package>",
    "evidence": "<directory>/offline-ocr-assets.lock.json",
    "source": "the exact package-lock.json production closure already installed by npm ci",
    "freshOutput": "stage in a private sibling directory and atomically rename only after validation",
    "requirements": [
      "Run after npm ci with install scripts disabled.",
      "Run on the Windows architecture targeted by the installer so the matching native canvas package is installed.",
      "Include the staged directory unpacked in installer application resources.",
      "Do not use PATH discovery, lifecycle scripts, runtime downloads, network access, or cloud fallback.",
      "Treat missing, unexpected, mismatched, linked, or empty runtime content as a packaging failure.",
      "Retain the per-file byte-size and SHA-256 evidence with the installer input."
    ]
  },
  "mandatoryReview": {
    "parserState": "requires-manual-confirmation",
    "bulkConfirmation": false,
    "evidenceRequired": [
      "source digest",
      "page digest",
      "token evidence digest",
      "source-relative geometry",
      "confidence"
    ],
    "delivery": "CRA mail-in PDF only",
    "electronicSubmission": false,
    "automaticFiling": false
  }
