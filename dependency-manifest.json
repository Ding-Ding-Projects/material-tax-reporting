{
  "schemaVersion": 1,
  "status": "package-runtime-declared",
  "toolchains": [
    {
      "name": "Node.js",
      "constraint": ">=22.13.0 || >=24",
      "purpose": "Local slip-parser OCR worker and PDF rasterization runtime"
    }
  ],
  "workspaces": [
    {
      "path": "apps/desktop",
      "manifest": "apps/desktop/package.json"
    },
    {
      "path": "apps/site",
      "manifest": "apps/site/package.json"
    },
    {
      "path": "packages/cra-pdf",
      "manifest": "packages/cra-pdf/package.json"
    },
    {
      "path": "packages/local-coding-assistants",
      "manifest": "packages/local-coding-assistants/package.json"
    },
    {
      "path": "packages/local-ollama",
      "manifest": "packages/local-ollama/package.json"
    },
    {
      "path": "packages/slip-parser",
      "manifest": "packages/slip-parser/package.json"
    },
    {
      "path": "packages/tax-domain",
      "manifest": "packages/tax-domain/package.json"
    }
  ],
  "binaries": [
    {
      "name": "@napi-rs/canvas Windows native addon",
      "version": "1.0.6",
      "source": "https://github.com/Brooooooklyn/canvas",
      "delivery": "npm optional platform package staged into installer resources",
      "networkAtRuntime": false
    },
    {
      "name": "Tesseract.js WebAssembly core",
      "version": "7.0.0",
      "source": "https://github.com/naptha/tesseract.js-core",
      "delivery": "tesseract.js-core package staged into installer resources",
      "networkAtRuntime": false
    }
  ],
  "dependencies": [
    {
      "name": "tesseract.js",
      "version": "7.0.0",
      "license": "Apache-2.0",
      "source": "https://github.com/naptha/tesseract.js"
    },
    {
      "name": "tesseract.js-core",
      "version": "7.0.0",
      "license": "Apache-2.0",
      "source": "https://github.com/naptha/tesseract.js-core"
    },
    {
      "name": "pdfjs-dist",
      "version": "6.1.200",
      "license": "Apache-2.0",
      "source": "https://github.com/mozilla/pdf.js"
    },
    {
      "name": "@napi-rs/canvas",
      "version": "1.0.6",
      "license": "MIT",
      "source": "https://github.com/Brooooooklyn/canvas"
    },
    {
      "name": "@tesseract.js-data/eng",
      "version": "1.0.0",
      "license": "MIT",
      "source": "https://github.com/naptha/tessdata"
    },
    {
      "name": "@tesseract.js-data/fra",
      "version": "1.0.0",
      "license": "MIT",
      "source": "https://github.com/naptha/tessdata"
    }
  ],
  "note": "Every current npm workspace is preserved in package-lock.json. Each workspace package.json remains authoritative for its own package requirements. The OCR production closure is additionally pinned with exact package metadata and integrity evidence in packages/slip-parser/assets/offline-ocr-runtime.json, then staged by packages/slip-parser/scripts/stage-offline-ocr-assets.mjs without PATH discovery or runtime download."
}
